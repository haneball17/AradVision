/*
 * AradVision SaaS 明亮主题样式表
 * 设计目标：现代、简洁、扁平化，强调留白与层级。
 */

/* ==================== 全局基础 ==================== */
QMainWindow {
    background-color: #F5F7FB;
}

QWidget {
    color: #1F2430;
    background-color: transparent;
    font-family: "Segoe UI", "PingFang SC", "Microsoft YaHei UI", sans-serif;
    font-size: 13px;
}

/* ==================== 结构容器 ==================== */
QWidget#TopCard,
QWidget#WorkspaceCard,
QWidget#LogCard,
QWidget#SessionPanel,
QWidget#CenterPanel,
QWidget#ExportPanelCard,
QWidget#PseudoPanelCard {
    background-color: #FFFFFF;
    border: none;
    border-radius: 12px;
}

QDockWidget {
    border: none;
}

QDockWidget::title {
    background-color: #FFFFFF;
    color: #1F2430;
    font-size: 13px;
    font-weight: 600;
    padding: 10px 12px;
    border: none;
}

QLabel#PageTitle {
    font-size: 20px;
    font-weight: 600;
    color: #1F2430;
}

QLabel#PageSubtitle {
    font-size: 12px;
    color: #5B6475;
}

QLabel#SectionTitle {
    font-size: 16px;
    font-weight: 600;
    color: #1F2430;
}

QLabel#SubSectionTitle {
    font-size: 14px;
    font-weight: 600;
    color: #2A3140;
}

QLabel#HintText {
    font-size: 12px;
    color: #98A2B3;
}

QLabel#StatusPill {
    background-color: #EEF2F8;
    color: #2A3140;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 12px;
    font-weight: 500;
}

/* ==================== 交互控件 ==================== */
QPushButton {
    min-height: 32px;
    padding: 0 14px;
    border-radius: 8px;
    border: none;
    background-color: #FFFFFF;
    color: #1F2430;
}

QPushButton:hover {
    background-color: #EEF2F8;
}

QPushButton:pressed {
    background-color: #E3EAF7;
}

QPushButton:disabled {
    background-color: #F2F4F7;
    color: #98A2B3;
}

QPushButton#PrimaryButton {
    background-color: #2F6BFF;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover {
    background-color: #2459D8;
}

QPushButton#PrimaryButton:pressed {
    background-color: #1D49B2;
}

QPushButton#PrimaryButton:disabled {
    background-color: #D0D5DD;
    color: #FFFFFF;
}

QPushButton#DangerButton {
    background-color: #F04438;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton#DangerButton:hover {
    background-color: #D92D20;
}

QPushButton#DangerButton:pressed {
    background-color: #B42318;
}

QPushButton#DangerButton:disabled {
    background-color: #F7B4AF;
    color: #FFFFFF;
}

QPushButton#SegmentButton {
    background-color: #EEF2F8;
    color: #344054;
    font-weight: 500;
}

QPushButton#SegmentButton:hover {
    background-color: #E4EAF4;
}

QPushButton#SegmentButton:checked {
    background-color: #2F6BFF;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton#GhostButton {
    background-color: #EEF2F8;
    color: #344054;
}

QPushButton#GhostButton:hover {
    background-color: #E4EAF4;
}

QLineEdit,
QComboBox,
QSpinBox {
    min-height: 32px;
    border: 1px solid #E7ECF3;
    border-radius: 6px;
    background-color: #FFFFFF;
    padding: 0 10px;
    color: #1F2430;
    selection-background-color: #2F6BFF;
    selection-color: #FFFFFF;
}

QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover {
    border-color: #CBD5E1;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus {
    border: 1px solid #2F6BFF;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    border: 1px solid #E7ECF3;
    background-color: #FFFFFF;
    selection-background-color: #EEF2F8;
    selection-color: #1F2430;
    outline: 0;
}

QHeaderView::section {
    background-color: #F8FAFC;
    color: #5B6475;
    font-size: 12px;
    font-weight: 600;
    border: none;
    border-bottom: 1px solid #EEF2F8;
    padding: 8px 10px;
}

QTableWidget,
QListWidget,
QPlainTextEdit {
    border: 1px solid #EEF2F8;
    border-radius: 8px;
    background-color: #FFFFFF;
    alternate-background-color: #FAFCFF;
    outline: none;
}

QTableWidget {
    gridline-color: #F1F5F9;
}

QTableWidget::item,
QListWidget::item {
    padding: 8px;
}

QTableWidget::item:selected,
QListWidget::item:selected {
    background-color: #E8F0FF;
    color: #1D49B2;
}

QTableWidget::item:hover,
QListWidget::item:hover {
    background-color: #F6F9FF;
}

QPlainTextEdit {
    background-color: #0F172A;
    color: #E2E8F0;
    border: none;
    border-radius: 8px;
    font-family: "Consolas", "JetBrains Mono", "Courier New", monospace;
    font-size: 12px;
    padding: 8px;
}

QLabel#VideoPreview {
    background-color: #0F172A;
    color: #94A3B8;
    border-radius: 10px;
    border: none;
}

QSplitter::handle {
    background-color: #F5F7FB;
}

QSplitter::handle:horizontal {
    width: 10px;
}

QSplitter::handle:vertical {
    height: 10px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #CDD6E1;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #B8C3D1;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
    border: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #CDD6E1;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #B8C3D1;
}
