/* =========================
   GLOBAL
========================= */

QWidget {
    background-color: #F3F4F6;
    color: #1F2937;
    font-family: "Segoe UI", "PingFang SC", "Microsoft YaHei UI";
    font-size: 13px;
}

/* =========================
   CARD CONTAINER
   使用 objectName="Card"
========================= */

QWidget#Card {
    background-color: #FFFFFF;
    border-radius: 12px;
    border: 1px solid #E5E7EB;
}

/* =========================
   TITLE LABELS
========================= */

QLabel#Title {
    font-size: 18px;
    font-weight: 600;
}

QLabel#SectionTitle {
    font-size: 15px;
    font-weight: 600;
}

/* =========================
   PUSH BUTTON
========================= */

QPushButton {
    height: 34px;
    padding: 0 14px;
    border-radius: 8px;
    border: 1px solid #E5E7EB;
    background-color: #FFFFFF;
}

QPushButton:hover {
    background-color: #F9FAFB;
}

QPushButton:pressed {
    background-color: #F3F4F6;
}

QPushButton:disabled {
    background-color: #F3F4F6;
    color: #9CA3AF;
}

/* Primary Button */

QPushButton#PrimaryButton {
    background-color: #2563EB;
    color: white;
    border: none;
}

QPushButton#PrimaryButton:hover {
    background-color: #1D4ED8;
}

QPushButton#PrimaryButton:pressed {
    background-color: #1E40AF;
}

/* Danger Button */

QPushButton#DangerButton {
    background-color: #EF4444;
    color: white;
    border: none;
}

QPushButton#DangerButton:hover {
    background-color: #DC2626;
}

/* =========================
   LINE EDIT
========================= */

QLineEdit {
    height: 32px;
    padding: 0 10px;
    border-radius: 6px;
    border: 1px solid #E5E7EB;
    background-color: #FFFFFF;
}

QLineEdit:focus {
    border: 2px solid #2563EB;
}

/* =========================
   COMBO BOX
========================= */

QComboBox {
    height: 32px;
    padding: 0 10px;
    border-radius: 6px;
    border: 1px solid #E5E7EB;
    background-color: #FFFFFF;
}

QComboBox:hover {
    background-color: #F9FAFB;
}

QComboBox::drop-down {
    border: none;
}

/* =========================
   SPIN BOX
========================= */

QSpinBox, QDoubleSpinBox {
    height: 32px;
    border-radius: 6px;
    border: 1px solid #E5E7EB;
    padding-left: 8px;
    background-color: #FFFFFF;
}

/* =========================
   CHECKBOX
========================= */

QCheckBox {
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #D1D5DB;
    background: white;
}

QCheckBox::indicator:checked {
    background-color: #2563EB;
    border: none;
}

/* =========================
   TABLE / LIST
========================= */

QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    gridline-color: #F3F4F6;
}

QHeaderView::section {
    background-color: #F9FAFB;
    border: none;
    border-bottom: 1px solid #E5E7EB;
    padding: 6px;
    font-weight: 600;
}

QTableWidget::item:selected {
    background-color: #DBEAFE;
}

/* =========================
   SCROLLBAR
========================= */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px;
}

QScrollBar::handle:vertical {
    background: #D1D5DB;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #9CA3AF;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    height: 0;
}

/* =========================
   SLIDER
========================= */

QSlider::groove:horizontal {
    height: 4px;
    background: #E5E7EB;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    background: #2563EB;
    margin: -5px 0;
    border-radius: 7px;
}

/* =========================
   TOOLTIP
========================= */

QToolTip {
    background-color: #111827;
    color: white;
    padding: 6px 8px;
    border-radius: 6px;
}

/* =========================
   GROUP BOX
========================= */

QGroupBox {
    border: 1px solid #E5E7EB;
    border-radius: 10px;
    margin-top: 12px;
    background-color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    left: 12px;
    font-weight: 600;
}

/* =========================
   STATUS COLORS (可用于自定义)
========================= */

QLabel#Success {
    color: #10B981;
}

QLabel#Warning {
    color: #F59E0B;
}

QLabel#Error {
    color: #EF4444;
}